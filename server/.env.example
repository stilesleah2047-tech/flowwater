# ---- Server ----
NODE_ENV=production
PORT=4000
# Comma-separated list of origins allowed to call this API / connect via Socket.io
CORS_ORIGINS=https://app.yourdomain.com

# ---- MongoDB ----
# MUST be a replica set (Atlas clusters are replica sets by default) —
# Change Streams, used for the live Super Admin feed, require it. A plain
# standalone mongod will connect fine but change streams will throw at
# startup; see src/sockets/index.ts.
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/aquaflow?retryWrites=true&w=majority

# ---- Auth / JWT ----
# Separate secrets for access vs refresh tokens — never reuse one secret
# for both, so a leaked access-token secret can't be used to forge
# long-lived refresh tokens.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Max simultaneous active devices for a DELIVERY-role account
DELIVERY_MAX_DEVICES=2

# ---- Safaricom Daraja ----
DARAJA_ENV=sandbox                 # sandbox | production
DARAJA_CONSUMER_KEY=xxxxxxxxxxxxxxxx
DARAJA_CONSUMER_SECRET=xxxxxxxxxxxxxxxx
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_URL=https://api.yourdomain.com/api/mpesa/callback
DARAJA_CALLBACK_IP_ALLOWLIST=

# ---- Seed / bootstrap ----
# Used once by `npm run seed` (see scripts) to create the first SUPER_ADMIN.
SEED_SUPER_ADMIN_EMAIL=admin@aquaflow.local
SEED_SUPER_ADMIN_PASSWORD=change_me_immediately
